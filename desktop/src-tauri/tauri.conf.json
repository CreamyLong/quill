{
  "productName": "Quill Desktop",
  "version": "0.8.0",
  "identifier": "com.quill.desktop",
  "build": {
    "beforeBuildCommand": "node scripts/prepare-bundle.mjs",
    "beforeDevCommand": "",
    "devUrl": "http://localhost:3100",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Quill Desktop",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "AI super-agent workstation",
    "longDescription": "Quill Desktop — open-source AI work assistant with sub-agent orchestration, sandbox execution, and extensible skills.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [],
    "resources": [
      "bundles/backend-bundle/**/*",
      "bundles/frontend-bundle/.quill-dist/**/*",
      "bundles/frontend-bundle/server.js",
      "bundles/frontend-bundle/package.json",
      "bundles/config.example.yaml"
    ],
    "copyright": "© 2026 Quill Contributors",
    "publisher": "Quill"
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlCNjU4RjY3RjJCRjYyM0YKUldTZ2lCUHlXeHdaREdHWEVQMW8zVjJjTWI3bE1jV0Z2MnVQOEp0NnBZbTU2WEZNUVZLV1JRbTAK",
      "endpoints": [
        "https://github.com/CreamyLong/quill/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
